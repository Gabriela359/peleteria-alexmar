# Frontend: Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public URL of the Node backend (used for reports and user administration).
VITE_EMAIL_API_URL=http://localhost:3001

# Backend only: required to register users from the application.
# Never expose this secret with the VITE_ prefix.
SUPABASE_SECRET_KEY=your_supabase_secret_key
# For older projects, SUPABASE_SERVICE_ROLE_KEY is also supported.
