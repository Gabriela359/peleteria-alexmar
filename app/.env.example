# Copia este archivo a .env.local y completa con los datos de tu proyecto
# de Supabase (Project Settings â†’ API).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_EMAIL_API_URL=http://localhost:3001

# Llave secreta del servidor (Project Settings â†’ API Keys). No es el Project ID
# ni la llave sb_publishable. Nunca usar el prefijo VITE_ ni exponer al navegador.
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Para proyectos antiguos tambiÃ©n se acepta SUPABASE_SERVICE_ROLE_KEY.

# En Render Free se recomienda Gmail API u otro proveedor HTTP; Gmail API
# requiere configurar OAuth en Google Cloud. EMAIL_FROM debe ser la cuenta
# autorizada. Todos estos secretos van solo en el backend, nunca en VITE_*.
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token
EMAIL_FROM=your_sender_email

# Alternativa: Resend requiere un dominio propio verificado.
RESEND_API_KEY=your_resend_api_key

# Alternativa SMTP para servidores que permitan salida en puertos SMTP.
EMAIL_HOST=your_smtp_host
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
REPORT_TO=your_report_recipient
