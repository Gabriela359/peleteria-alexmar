# Copia este archivo a .env.local y completa con los datos de tu proyecto
# de Supabase (Project Settings â†’ API).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_EMAIL_API_URL=http://localhost:3001

# Llave secreta del servidor (Project Settings â†’ API Keys). No es el Project ID
# ni la llave sb_publishable. Nunca usar el prefijo VITE_ ni exponer al navegador.
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Para proyectos antiguos tambiÃ©n se acepta SUPABASE_SERVICE_ROLE_KEY.

# SMTP para envio real de reportes por correo
EMAIL_HOST=your_smtp_host
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM=your_sender_email
REPORT_TO=your_report_recipient
